CURRENCY=UZS

# --- Guruhdan asosiy guruhga tezkor yo'naltirish ---
# Bo'sh qoldirilsa PRIMARY_GROUP_ID (426. Global) ishlatiladi.
# MAIN_GROUP_ID=-1003956911813
# Bo'sh = bot turgan barcha guruhlar (asosiy dan tashqari).
# SOURCE_GROUP_IDS=-1002296741378,-1003189462638,-1002200785842
# Bir odam bir xil matnni shu daqiqa ichida faqat bir marta yuboradi.
DEDUP_MINUTES=10
RELAY_MIN_SCORE=3
RELAY_MAX_CHARS=400
# Guruh limiti ~20/min. Oddiy holatda navbat kutmaydi.
RELAY_RATE_PER_MINUTE=18
# auto: Heroku'da webhook, lokalda polling. 0 — faqat polling.
USE_WEBHOOK=auto
# WEBHOOK_URL=https://beshariqbot.herokuapp.com
# WEBHOOK_SECRET=

# Muhim (Heroku): SQLite dyno restartida O'CHADI — foydalanuvchi/haydovchi
# sonlari har kuni "nolga" qaytadi. Doimiy baza UCHUN Postgres majburiy:
#   heroku login
#   heroku addons:create heroku-postgresql:essential-0 -a beshariqbot
# Heroku DATABASE_URL ni o'zi qo'yadi. Lokalda bo'sh qoldiring → data/bot.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
