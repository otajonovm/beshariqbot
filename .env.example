# Qayta yoqish uchun true qiling VA token/admin to'g'ri bo'lsin
BOT_ENABLED=false

# Telegram BotFather'dan olingan token
BOT_TOKEN=123456789:AA-your-telegram-bot-token

# Asosiy haydovchilar guruhi
PRIMARY_GROUP_ID=-1003956911813
PRIMARY_GROUP_INVITE=https://t.me/+nsAZI5HKm4E5OWYy
PRIMARY_GROUP_TITLE=426. Global
BOT_USERNAME=beshariq_toshkent_taxi_uzbot

# Barcha guruhlar (birinchi = asosiy). Buyurtma faqat asosiy guruhga tushadi.
SUPERGROUP_IDS=-1003956911813,-1002296741378,-1003189462638,-1002200785842

# Faqat SIZNING Telegram ID — boshqa odamniki bo'lsa xabarlar u yerga ketadi
ADMIN_ID=123456789
CURRENCY=UZS

# Muhim (Heroku): SQLite dyno restartida o'chadi — haydovchilar qayta registratsiya
# so'raladi. Doimiy baza uchun Postgres ulang:
#   heroku addons:create heroku-postgresql:essential-0
# Heroku DATABASE_URL ni o'zi qo'yadi. Lokalda bo'sh qoldiring → data/bot.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
