# Telegram BotFather'dan olingan token
BOT_TOKEN=123456789:AA-your-telegram-bot-token

# Asosiy haydovchilar guruhi
PRIMARY_GROUP_ID=-1003956911813
PRIMARY_GROUP_INVITE=https://t.me/+nsAZI5HKm4E5OWYy
PRIMARY_GROUP_TITLE=426. Global
BOT_USERNAME=beshariq_toshkent_taxi_uzbot

# Barcha guruhlar (birinchi = asosiy). Buyurtma hammaga tushadi.
SUPERGROUP_IDS=-1003956911813,-1004421198641,-1002296741378,-1003189462638,-1002200785842

ADMIN_ID=123456789
# Qo'shimcha adminlar (vergul bilan) — to'liq huquq: /admin, stats, extend
ADMIN_IDS=5265031638
CURRENCY=UZS

# --- Guruhdan asosiy guruhga tezkor yo'naltirish ---
# Bo'sh qoldirilsa PRIMARY_GROUP_ID (426. Global) ishlatiladi.
# MAIN_GROUP_ID=-1003956911813
# Bo'sh = bot turgan barcha guruhlar (asosiy dan tashqari).
# SOURCE_GROUP_IDS=-1002296741378,-1003189462638,-1002200785842
# Admin emas yozsa → xabar o'chirilib asosiy guruhga o'tkaziladi.
SWEEP_GROUP_IDS=-1003189462638
# Bir odam bir xil matnni shu daqiqa ichida faqat bir marta yuboradi.
DEDUP_MINUTES=10
RELAY_MIN_SCORE=3
RELAY_MAX_CHARS=400
# Guruh limiti ~20/min. Oddiy holatda navbat kutmaydi.
RELAY_RATE_PER_MINUTE=18

# --- Haydovchi e'lonlari ---
# Bo'sh = SUPERGROUP_IDS dan 426. Global chiqariladi (426 faqat yo'lovchi/taksi).
# Aniq ro'yxat: DRIVER_POST_GROUP_IDS=-1004421198641,-1002296741378
DRIVER_POST_GROUP_IDS=
# Oldindan ko'rish (✅/❌). false = darhol yuborish.
DRIVER_RAW_CONFIRM=true
# Soatiga nechta xom e'lon.
DRIVER_POST_LIMIT_PER_HOUR=20
# Avto-e'lon: interval (soniya) va davomiylik (daqiqa)
AUTO_POST_INTERVALS_SEC=30,60
AUTO_POST_DURATIONS_MIN=60,120,180
AUTO_POST_MAX_HOURS=3
# Yangi avto-e'londan keyin o'sha guruhdagi eski xabarni o'chirish
RELAY_REPOST_DELETE_OLD=true
# auto: Railway'da webhook, lokalda polling. 0 — faqat polling.
USE_WEBHOOK=auto
# Railway public domain (Settings → Networking → Generate Domain)
# WEBHOOK_URL=https://your-service.up.railway.app
# WEBHOOK_SECRET=

# Railway Postgres. Lokalda bo'sh qoldiring → data/bot.db
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- To'lov / premium / reklama ---
DRIVER_MONTHLY_FEE=300000
GRACE_DAYS=1
PAYMENT_START_DAYS=7
PAYMENTS_ENABLED=true
# ADMIN_CONTACT=@admin_username
# Reklama interval default (soat). Panelda soniya bilan ham sozlanadi (30s…3 soat).
AD_INTERVAL_HOURS=2
AD_ACTIVE_FROM=07:00
AD_ACTIVE_TO=23:00
# Default banner: assets/ad_banner.jpg (yo'q bo'lsa faqat matn)
